{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portals-grok.local/schema/material.json",
  "title": "Material library",
  "type": "object",
  "required": ["id", "materials"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "materials": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/material" }
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "properties": {
        "recipe": { "enum": ["tile", "circuit", "stripe", "speckle", "cloud", "wood", "plaster", "brick", "stone", "metal", "fabric", "dirt"] },
        "ior": { "type": "number" },
        "transmission": { "type": "number" },
        "overlay": { "type": "string" },
        "clearcoat": { "type": "number" },
        "sheen": { "type": "number" },
        "envMapIntensity": { "type": "number" },
        "color": { "type": ["string", "number"] },
        "line": { "type": ["string", "number"] },
        "cells": { "type": "number" },
        "repeat": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "roughness": { "type": "number" },
        "metalness": { "type": "number" },
        "emissive": { "type": ["string", "number"] },
        "emissiveIntensity": { "type": "number" },
        "map": { "type": "string" },
        "roughnessMap": { "type": "string" },
        "normalMap": { "type": "string" },
        "surface": { "type": "string" }
      }
    }
  }
}
